PORT=8080
DATABASE_PATH=/data/swapcheck.db
UPLOAD_DIR=/data/uploads
SECRET_KEY=change-me

OWNER_PASSWORD=
TECH_PASSWORD=

BUSINESS_NAME=
# Absolute base for magic /d/{token} links — no trailing slash.
PUBLIC_BASE_URL=http://localhost:8080

# Max photo upload size in megabytes. Default 5.
MAX_UPLOAD_MB=5

# Optional office decide notify destinations.
OFFICE_EMAIL=
OFFICE_PHONE=

# Optional SMTP. Leave SMTP_HOST unset; decide + CSV still work.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# FROM_EMAIL=
# FROM_NAME=

# Optional Twilio SMS. Leave unset.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Optional footer. Leave empty for Verifier / Gumroad.
MARKETING_URL=
